{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Superserve",
  "colors": {
    "primary": "#B2FAB4",
    "light": "#B2FAB4",
    "dark": "#B2FAB4"
  },
  "fonts": {
    "heading": {
      "family": "Instrument Sans"
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "background": {
    "color": {
      "dark": "#141414"
    },
    "decoration": "gradient"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "vitesse-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "logo": "/logo.svg",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/superserve-ai/superserve"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://console.superserve.ai/auth/signup/?utm_source=docs&utm_medium=navbar"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "mcp", "add-mcp", "cursor", "vscode"]
  },
  "redirects": [
    {
      "source": "/integrations/virtual-filesystems/mesa",
      "destination": "/storage/mesa"
    },
    {
      "source": "/integrations/virtual-filesystems/archil",
      "destination": "/storage/archil"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "api-key"]
          },
          {
            "group": "Sandbox",
            "pages": [
              "sandbox/create",
              "sandbox/connect",
              "sandbox/lifecycle",
              "sandbox/metadata",
              "sandbox/networking",
              "sandbox/network-log"
            ]
          },
          {
            "group": "Secrets & env vars",
            "pages": [
              "sandbox/environment-variables",
              "secrets/overview",
              "secrets/create",
              "secrets/binding",
              "secrets/audit"
            ]
          },
          {
            "group": "Templates",
