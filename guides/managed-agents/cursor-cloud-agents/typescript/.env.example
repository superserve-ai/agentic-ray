# Superserve API key (console.superserve.ai -> API keys)
SUPERSERVE_API_KEY=

# Cursor Enterprise service-account API key. Other key types cannot start pool workers.
CURSOR_API_KEY=

# Pool the controller watches. Must match the pool users pick in Cursor.
CURSOR_POOL=superserve

# Template built by build-template.mjs
# CURSOR_WORKER_TEMPLATE=cursor-worker

# Seconds a worker stays connected after a session ends, waiting for follow-ups.
# CURSOR_WORKER_IDLE_RELEASE_TIMEOUT=600

# Let the worker clone the requested repos with a Cursor-minted GitHub token.
# CURSOR_WORKER_CLONE_GIT_REPOS=true

# Pause sandboxes when the worker exits instead of deleting them, so follow-ups
# resume with the workspace intact. See the guide's Hibernation section.
# CURSOR_WORKER_HIBERNATE=false

# Delete a paused sandbox after it has been paused this long (garbage collection).
# SANDBOX_AUTO_DELETE_SECONDS=86400

# Optional strict egress allowlist for worker sandboxes (comma-separated hosts/CIDRs).
# CURSOR_WORKER_ALLOW_OUT=api2.cursor.sh,api2direct.cursor.sh,downloads.cursor.com,cloud-agent-artifacts.s3.us-east-1.amazonaws.com,github.com,*.github.com,*.githubusercontent.com

# MONITOR_POLL_SECONDS=15
# MONITOR_GRACE_SECONDS=120
